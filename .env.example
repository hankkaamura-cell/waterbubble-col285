# Copy this file to .env before running the backend.

# Optional: only needed for Inara commander/profile-style calls.
# Inara is NOT used here as a public market-data source.
INARA_API_KEY=
INARA_APP_NAME=WaterBubbleMap
INARA_APP_VERSION=0.1.0

# EDDN live relay.
EDDN_RELAY=tcp://eddn.edcd.io:9500

# Comma-separated systems that the EDDN listener should keep.
# Leave blank to read from ../data/waterbubble_systems.json
WATERBUBBLE_SYSTEMS=

DEFAULT_MAX_MARKET_AGE_HOURS=48
